{
  "name": "toolorbit",
  "version": "1.0.0",
  "private": true,
  "description": "ToolOrbit — browser-first online tools platform (Next.js, PostgreSQL, Prisma)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@jsquash/avif": "^2.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "cronstrue": "^3.35.0",
    "csso": "^5.0.5",
    "diceware-wordlist-en-eff": "^1.0.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "entities": "^8.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "js-beautify": "^2.0.3",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.59.0",
    "marked": "^16.4.2",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "sanitize-html": "^2.18.1",
    "spark-md5": "^3.0.2",
    "terser": "^5.51.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/csso": "^5.0.5",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
