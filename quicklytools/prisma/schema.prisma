// QuicklyTools database schema.
//
// Tool *functionality* lives in code (src/tools). The database only stores
// administrator overrides (names, SEO, visibility, ordering), site content,
// settings, aggregated statistics and security records. Public pages read
// these through a tag-cached data layer, so the database is not hit per visit.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  seoRevisions SeoRevision[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

/// Administrator overrides for a tool. `toolId` is the immutable id from the code registry.
model ToolOverride {
  toolId        String   @id
  name          String?
  categoryId    String?
  description   String?
  icon          String?
  enabled       Boolean?
  popular       Boolean?
  sortOrder     Int?
  searchVisible Boolean?
  relatedIds    String[] @default([])
  hasRelated    Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

/// Per-tool SEO overrides. Null fields fall back to the code defaults.
model ToolSeo {
  toolId             String   @id
  slug               String?  @unique
  title              String?
  metaDescription    String?
  canonical          String?
  robotsIndex        Boolean?
  robotsFollow       Boolean?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  twitterCard        String?
  h1                 String?
  intro              String?
  body               String?
  faq                Json?
  internalLinks      Json?
  structuredData     Boolean?
  updatedAt          DateTime @updatedAt
}

model SeoRevision {
  id        String     @id @default(cuid())
  toolId    String
  field     String
  oldValue  Json?
  newValue  Json?
  batchId   String?
  note      String?
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([toolId, createdAt])
  @@index([batchId])
}

model CategoryOverride {
  categoryId      String   @id
  name            String?
  description     String?
  intro           String?
  seoTitle        String?
  metaDescription String?
  sortOrder       Int?
  updatedAt       DateTime @updatedAt
}

/// Static content pages (about, contact, privacy-policy, terms-of-service, faq).
model SitePage {
  slug            String   @id
  title           String
  body            String
  metaDescription String?
  published       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Key/value JSON settings: site, home, footer, navigation, ads.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  enabled    Boolean  @default(true)
  hits       Int      @default(0)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Aggregated daily counters. Written in batches by the in-memory analytics buffer.
model DailyStat {
  date  DateTime @db.Date
  kind  String // "view" | "use"
  key   String // tool id or page path
  count Int      @default(0)

  @@id([date, kind, key])
  @@index([kind, date])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String // "client" | "server"
  message   String
  stack     String?
  path      String?
  userAgent String?
  count     Int      @default(1)
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
