# Generated from site.conf.template at container start (envsubst).

server {
  listen 80;
  server_name ${SERVER_NAME} www.${SERVER_NAME};

  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://${SERVER_NAME}$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name www.${SERVER_NAME};
  ssl_certificate ${SSL_CERT};
  ssl_certificate_key ${SSL_KEY};
  include /etc/nginx/snippets/ssl.conf;
  return 301 https://${SERVER_NAME}$request_uri;
}

server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate ${SSL_CERT};
  ssl_certificate_key ${SSL_KEY};
  include /etc/nginx/snippets/ssl.conf;

  limit_conn perip 100;
  include /etc/nginx/snippets/proxy.conf;

  # Internal endpoints are only callable from inside the container network.
  location /api/internal/ { return 404; }

  # Immutable build assets: cache for a year at nginx and the CDN.
  location /_next/static/ {
    proxy_pass http://app;
    proxy_cache static;
    proxy_cache_valid 200 30d;
    add_header X-Cache $upstream_cache_status;
    expires 1y;
    access_log off;
  }

  location = /api/health {
    proxy_pass http://app;
    access_log off;
  }

  # APIs: never cached, stricter rate limit.
  location /api/ {
    limit_req zone=api burst=30 nodelay;
    proxy_pass http://app;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
  }

  # Login: strict per-IP limit on top of the app's own lockout.
  location = /admin/login {
    limit_req zone=login burst=10 nodelay;
    proxy_pass http://app;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Cache-Control "private, no-store, max-age=0" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
  }

  # Admin: never cached, rate limited, no indexing.
  location /admin {
    limit_req zone=admin burst=100 nodelay;
    proxy_pass http://app;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Cache-Control "private, no-store, max-age=0" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
  }

  # Public pages: 30s micro-cache, stale-while-updating, request collapsing.
  location / {
    limit_req zone=general burst=60 nodelay;
    proxy_pass http://app;
    proxy_cache pages;
    proxy_cache_key "$scheme$host$request_uri";
    proxy_cache_methods GET HEAD;
    proxy_ignore_headers Cache-Control Expires Set-Cookie;
    proxy_cache_valid 200 301 308 30s;
    proxy_cache_valid 404 10s;
    proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_bypass $skip_cache $http_rsc $http_next_router_state_tree;
    proxy_no_cache $skip_cache $http_rsc $http_next_router_state_tree;
    add_header X-Cache $upstream_cache_status;
  }
}
