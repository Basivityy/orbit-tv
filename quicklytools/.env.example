# ---------------------------------------------------------------------------
# QuicklyTools configuration. Copy to .env and fill in. NEVER commit .env.
# scripts/install.sh generates strong random secrets for you.
# ---------------------------------------------------------------------------

# Public site
SERVER_NAME=example.com                 # bare domain used by nginx
SITE_URL=https://example.com            # canonical origin (no trailing slash)
SITE_NAME=QuicklyTools
CONTACT_EMAIL=hello@example.com

# PostgreSQL (the database is only reachable inside the Docker network)
POSTGRES_USER=quicklytools
POSTGRES_PASSWORD=change-me-generated-by-install-script
POSTGRES_DB=quicklytools
DB_POOL_SIZE=10

# Random secret (≥32 chars) protecting the internal cache-refresh endpoint
INTERNAL_API_SECRET=change-me-generated-by-install-script

# TLS certificate paths inside the nginx container
#  - Cloudflare Origin Certificate: put files in deploy/certs/fullchain.pem + privkey.pem (defaults)
#  - Let's Encrypt: SSL_CERT=/etc/nginx/certs/live/example.com/fullchain.pem
#                   SSL_KEY=/etc/nginx/certs/live/example.com/privkey.pem
SSL_CERT=/etc/nginx/certs/fullchain.pem
SSL_KEY=/etc/nginx/certs/privkey.pem

# Optional: Cloudflare cache purge after admin edits (token needs Zone → Cache Purge)
CF_API_TOKEN=
CF_ZONE_ID=

# Optional: IPv6-only test endpoint for the IPv6 checker (e.g. https://ipv6.example.com/api/ip,
# a hostname with only an AAAA record pointing to this server). Baked in at build time.
NEXT_PUBLIC_IPV6_TEST_URL=

# Staging servers: block all crawlers
ROBOTS_DISALLOW_ALL=false

# Image tag used by docker compose (set automatically by scripts/update.sh)
APP_TAG=latest
APP_MEMORY_LIMIT=1g
